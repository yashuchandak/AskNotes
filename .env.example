# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OAuth client ID from Google Auth Platform > Clients
GOOGLE_CLIENT_ID=

# Optional: defaults to the free-tier Gemini 2.5 Flash-Lite model
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: defaults to 3000
# PORT=3000

# Optional: public origin used by Google sign-in (must match the OAuth client settings)
# APP_ORIGIN=http://localhost:3000
